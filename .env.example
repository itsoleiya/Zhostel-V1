# Base path. "/" for zhostel.com, Netlify or Vercel; "/Zhostel-V1/" for GitHub Pages.
VITE_BASE=/

# Public URL of THIS deployment (used for canonical tags and sitemap.xml).
VITE_SITE_URL=https://zhostel.com

# Where /wp-content/... images, PDFs and video are served from.
#  - empty (default)        -> this site's own copies in public/wp-content (standalone)
#  - "https://zhostel.com"  -> hotlink the old WordPress site (temporary only; do not use in production)
VITE_ASSET_ORIGIN=

# Supabase (project "Zhostel V1"). Contact form messages go to the contact_messages table.
# Defaults are built in; override here to point at another project.
VITE_SUPABASE_URL=https://pdiypxgvfzaiweiuhstf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GbIC2cAwr9zQJyekbS3ZMQ_5BxeKJB0

# Optional alternative when Supabase is not configured: form endpoint that accepts a JSON POST (e.g. Formspree, Basin, your own API).
# When empty, the contact form opens the visitor's email app with the message pre-filled.
VITE_CONTACT_ENDPOINT=

# Set to "true" to load Raleway from Google Fonts. The live site declares Raleway but never
# loads it, so visitors see Arial; "false" reproduces that exactly.
VITE_LOAD_RALEWAY=false
